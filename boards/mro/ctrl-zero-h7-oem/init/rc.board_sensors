#!/bin/sh
#
# board specific sensors init
#------------------------------------------------------------------------------

if param compare SENS_EN_INA220 1
then
	# Start Digital power monitors
	# ina220 -X -b 1 -a 0x41 -T VBATT -k start
	ina220 -X -b 1 -a 0x44 -T VBATT -k start
	ina220 -X -b 1 -a 0x45 -T VREG -k start
else
	board_adc start
fi

# Internal ICM-20602
icm20602 -s -b 1 -R 8 start

# Internal SPI bus BMI088 accel & gyro
bmi088 -A -s -b 5 -R 8 start
bmi088 -G -s -b 5 -R 8 start

# Internal ICM-20948 (with magnetometer)
icm20948 -s -b 1 -R 8 -M start

# Interal DPS310 (barometer)
dps310 -s -b 2 start
